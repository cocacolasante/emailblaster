ANTHROPIC_API_KEY=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GrantMind Admin
# Set to false to mirror "Click tracking" being turned OFF in the Brevo
# dashboard (Transactional → Settings).  When false, the app reports
# click-rate as "not tracked" instead of a misleading 0%.  Default: true.
EMAIL_CLICK_TRACKING_ENABLED=true

APOLLO_API_KEY=
HUNTER_API_KEY=

ENCRYPTION_KEY=

IMAP_POLL_INTERVAL_MINUTES=20

SECRET_KEY=

FRONTEND_URL=http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:8000
# Brevo outbound (transactional event) webhook — real-time delivered/bounce/
# spam/unsubscribe/blocked events.  Static shared-secret header: set this to a
# random value AND add it as the "X-Brevo-Auth" custom header on the webhook in
# Brevo (scripts/dev_tunnel.py registers it for you against the live tunnel).
# Empty → the /webhooks/brevo route rejects everything.
BREVO_WEBHOOK_SECRET=
BREVO_WEBHOOK_AUTH_HEADER=X-Brevo-Auth
