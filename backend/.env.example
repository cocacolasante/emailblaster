# Database
DATABASE_URL=postgresql+asyncpg://emailblaster:emailblaster@postgres:5432/emailblaster

# Redis
REDIS_URL=redis://redis:6379/0

# Anthropic
ANTHROPIC_API_KEY=

# Email sending
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_SENDER_NAME=Email Blaster

# Enrichment (optional — app degrades gracefully without these)
APOLLO_API_KEY=
HUNTER_API_KEY=

# Credential encryption (REQUIRED — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: if this key is lost, all stored inbox passwords are unrecoverable.)
ENCRYPTION_KEY=

# IMAP polling interval (applies globally across all connected accounts)
IMAP_POLL_INTERVAL_MINUTES=20

# App
SECRET_KEY=dev-secret-change-me
FRONTEND_URL=http://localhost:5173
WEBHOOK_BASE_URL=http://localhost:8000
